{
  "$schema": "https://json-structure.org/meta/extended/v0/#",
  "$id": "https://example.com/test-abstract-validation",
  "type": "object",
  "name": "AbstractValidation",
  "properties": {
    "validField": {
      "type": "string",
      "description": "A normal field"
    },
    "invalidField": {
      "$ref": "#/definitions/AbstractBase",
      "description": "This should trigger a warning - direct reference to abstract type"
    }
  },
  "definitions": {
    "AbstractBase": {
      "type": "object",
      "name": "AbstractBase",
      "abstract": true,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "ConcreteImpl": {
      "type": "object",
      "name": "ConcreteImpl",
      "$extends": "#/definitions/AbstractBase",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": ["name"]
    }
  }
}
