package {{ base_package }}

import (
    "math/rand"
    "time"
    {%- if avro_annotation %}
    "github.com/iskorotkov/avro/v2"
    {%- endif %}
)

{%- if avro_annotation %}
// Bound collection allocations before decoding untrusted Avro block counts.
var avroCodec = avro.Config{
    MaxSliceAllocSize: 1 << 20,
    MaxMapAllocSize: 1 << 20,
}.Freeze()
{% endif %}

func init() {
    rand.Seed(time.Now().UnixNano())
}

func Opt[T any](s T) *T {
	return &s
}

{%- for struct in structs %}
func random{{ struct.name }}() {{ struct.name }} {
    return {{ struct.name }} {
        {%- for field in struct.fields %}
        {{ field.name }}: {{ field.value }},
        {%- endfor %}
    }
}
{%- endfor %}

{%- for enum in enums %}
func random{{ enum.name }}() {{ enum.name }} {
    return {% if enum.string_enum %}{{ enum.name }}_{{ enum.symbols[0] }}{% else %}0{% endif %}
}
{%- endfor %}

