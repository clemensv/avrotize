        let value_bytes = {{ union_enum_name }}::to_nullable_byte_array(
            Some(&instance),
            "avro/binary+gzip",
        ).unwrap();
        assert_eq!(
            {{ union_enum_name }}::from_nullable_data(
                &value_bytes,
                "avro/binary+gzip",
            ).unwrap(),
            Some(instance),
        );
    }
