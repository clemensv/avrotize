impl {{ union_enum_name }} {
    fn xml_probe_matches_selected(&self) -> bool {
        match self {
            {%- for union_field in union_fields %}
            {{ union_enum_name }}::{{ union_field.name }}(value) => {
                let xml = match crate::xml_support::with_xml_union_probe(
                    || quick_xml::se::to_string(
                        &XmlUnionProbeRef { value }
                    )
                ) {
                    Ok(xml) => xml,
                    Err(_) => return false,
                };
                let match_count = 0usize
                    {%- for candidate in union_fields %}
                    + usize::from(match quick_xml::de::from_str::<
                        XmlUnionProbe<{{ candidate.type }}>
                    >(&xml) {
                        Ok(probe) => serde_json::to_value(probe.value)
                            .map(|node| {{ candidate.json_match_predicate }})
                            .unwrap_or(false),
                        Err(_) => false,
                    })
                    {%- endfor %};
                let selected_matches = match quick_xml::de::from_str::<
                    XmlUnionProbe<{{ union_field.type }}>
                >(&xml) {
                    Ok(probe) => serde_json::to_value(probe.value)
                        .map(|node| {{ union_field.json_match_predicate }})
                        .unwrap_or(false),
                    Err(_) => false,
                };
                if match_count != 1 || !selected_matches {
                    return false;
                }
                let node = match serde_json::to_value(value) {
                    Ok(node) => normalize_xml_value(node),
                    Err(_) => return false,
                };
                let normalized_match_count = 0usize
                    {%- for candidate in union_fields %}
                    + usize::from({{ candidate.json_match_predicate }})
                    {%- endfor %};
                normalized_match_count == 1
                    && {{ union_field.json_match_predicate }}
            },
            {%- endfor %}
        }
    }
}
