impl {{ union_enum_name }} {
    fn xml_probe_matches_selected(&self) -> bool {
        match self {
            {%- for union_field in union_fields %}
            {{ union_enum_name }}::{{ union_field.name }}(value) => {
                {%- if union_field.xml_representation == "sequence" %}
                let wire_value = XmlSequenceRef { item: value };
                {%- elif union_field.xml_representation == "map" %}
                let wire_value = XmlMapRef { entries: value };
                {%- else %}
                let wire_value = value;
                {%- endif %}
                let xml = match crate::xml_support::with_xml_union_probe(
                    || quick_xml::se::to_string(
                        &XmlUnionProbeRef { value: &wire_value }
                    )
                ) {
                    Ok(xml) => xml,
                    Err(_) => return false,
                };
                let content = match quick_xml::de::from_str::<
                    XmlUnionProbe<crate::xml_support::XmlValue>
                >(&xml) {
                    Ok(probe) => probe.value,
                    Err(_) => return false,
                };
                let mut matched_variant = None;
                let mut match_count = 0usize;
                let mut canonical_variant = None;
                let mut canonical_count = 0usize;
                {%- for candidate in union_fields %}
                let candidate_matches = xml_candidate_matches({
                    let node = &content;
                    {{ candidate.xml_borrowed_match_predicate }}
                });
                if candidate_matches {
                    match_count += 1;
                    matched_variant.get_or_insert({{ loop.index0 }});
                    let canonical_matches = {
                        let node = &content;
                        {{ candidate.xml_canonical_match_predicate }}
                    };
                    if canonical_matches {
                        canonical_count += 1;
                        canonical_variant.get_or_insert({{ loop.index0 }});
                    }
                }
                {%- endfor %}
                let selected_variant = if canonical_count == 1 {
                    canonical_variant
                } else if canonical_count == 0 && match_count == 1 {
                    matched_variant
                } else {
                    None
                };
                selected_variant == Some({{ loop.index0 }})
            },
            {%- endfor %}
        }
    }
}
