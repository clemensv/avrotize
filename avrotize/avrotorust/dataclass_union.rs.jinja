impl<'de> Deserialize<'de> for {{ union_enum_name }} {
    fn deserialize<D>(deserializer: D) -> Result<{{ union_enum_name }}, D::Error>
    where
        D: serde::de::Deserializer<'de>
    {
        {%- if xml_annotation %}
        let is_xml = std::any::type_name::<D>().contains("quick_xml")
            || crate::xml_support::xml_union_deserialize_active();
        if is_xml {
            let content = crate::xml_support::XmlValue::deserialize(
                deserializer
            )?;
            let mut matched_variant = None;
            let mut match_count = 0usize;
            let mut canonical_variant = None;
            let mut canonical_count = 0usize;
            {%- for union_field in union_fields %}
            let candidate_matches = xml_candidate_matches({
                let node = &content;
                {{ union_field.xml_borrowed_match_predicate }}
            });
            if candidate_matches {
                match_count += 1;
                matched_variant.get_or_insert({{ loop.index0 }});
                let canonical_matches = {
                    let node = &content;
                    {{ union_field.xml_canonical_match_predicate }}
                };
                if canonical_matches {
                    canonical_count += 1;
                    canonical_variant.get_or_insert({{ loop.index0 }});
                }
            }
            {%- endfor %}
            let selected_variant = if canonical_count == 1 {
                canonical_variant
            } else if canonical_count == 0 && match_count == 1 {
                matched_variant
            } else if match_count > 0 {
                return Err(serde::de::Error::custom(
                    "ambiguous XML union value"
                ));
            } else {
                None
            };
            return match selected_variant {
                {%- for union_field in union_fields %}
                Some({{ loop.index0 }}) => {
                    #[cfg(test)]
                    XML_SELECTED_DECODE_COUNT.with(
                        |count| count.set(count.get() + 1)
                    );
                    crate::xml_support::with_xml_union_deserialize(
                    {%- if union_field.xml_representation == "sequence" %}
                        || <XmlSequence<{{ union_field.xml_sequence_item_type }}>>::deserialize(
                            content
                        ).map(|wire| wire.item.0)
                    {%- elif union_field.xml_representation == "map" %}
                        || <XmlMap<{{ union_field.type }}>>::deserialize(
                            content
                        ).map(|wire| wire.entries)
                    {%- else %}
                        || <{{ union_field.type }}>::deserialize(content)
                    {%- endif %}
                    )
                    .map({{ union_enum_name }}::{{ union_field.name }})
                    .map_err(serde::de::Error::custom)
                },
                {%- endfor %}
                _ => Err(serde::de::Error::custom("No valid variant found")),
            }
        }
        {%- endif %}
        let node = serde_json::Value::deserialize(deserializer)?;
        let mut matched_variant = None;
        {%- for union_field in union_fields %}
        if json_candidate_matches({
            let node = &node;
            {{ union_field.json_value_match_predicate }}
        }) {
            if matched_variant.replace({{ loop.index0 }}).is_some() {
                return Err(serde::de::Error::custom(
                    "ambiguous JSON union value"
                ));
            }
        }
        {%- endfor %}
        match matched_variant {
            {%- for union_field in union_fields %}
            Some({{ loop.index0 }}) => {
                #[cfg(test)]
                JSON_SELECTED_DECODE_COUNT.with(
                    |count| count.set(count.get() + 1)
                );
                <{{ union_field.type }}>::deserialize(node)
                    .map({{ union_enum_name }}::{{ union_field.name }})
                    .map_err(serde::de::Error::custom)
            },
            {%- endfor %}
            _ => Err(serde::de::Error::custom("No valid variant found")),
        }
    }
}

