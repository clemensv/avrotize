    {%- if avro_annotation and source_null_index >= 0 %}
    #[test]
    fn test_nullable_avro_{{ union_enum_name.lower() }}() {
        let null_bytes = {{ union_enum_name }}::to_nullable_byte_array(
            None,
            "avro/binary",
        ).unwrap();
        assert_eq!(
            {{ union_enum_name }}::from_nullable_data(
                &null_bytes,
                "avro/binary",
            ).unwrap(),
            None,
