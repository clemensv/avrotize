pub(crate) const MAX_XML_DATA_SIZE: usize = 16 * 1024 * 1024;
const MAX_XML_DEPTH: usize = 128;

#[derive(Debug, PartialEq)]
pub(crate) enum XmlValue {
    Bool(bool),
    I64(i64),
    U64(u64),
    F64(f64),
    String(String),
    Unit,
    Option(Option<Box<XmlValue>>),
    Seq(Vec<XmlValue>),
    Map(XmlMapValue),
    Bytes(Vec<u8>),
}

#[derive(Debug, PartialEq)]
pub(crate) struct XmlMapValue {
    values: Vec<(XmlValue, XmlValue)>,
    indexes: HashMap<String, usize>,
}

struct XmlValueVisitor;

#[cfg(test)]
thread_local! {
    static XML_MAP_LOOKUP_COUNT: Cell<usize> = const { Cell::new(0) };
    static XML_MAP_PROBE_LOOKUP_COUNT: Cell<usize> = const { Cell::new(0) };
}

fn push_xml_map_entry(
    values: &mut Vec<(XmlValue, XmlValue)>,
    indexes: &mut HashMap<String, usize>,
    key: XmlValue,
    value: XmlValue,
) {
    let index = match &key {
        XmlValue::String(key) => {
            #[cfg(test)]
            XML_MAP_LOOKUP_COUNT.with(|count| count.set(count.get() + 1));
            indexes.get(key).copied()
        }
        _ => None,
    };
    if let Some(index) = index {
        let existing = &mut values[index].1;
        match existing {
            XmlValue::Seq(items) => items.push(value),
            _ => {
                let first = std::mem::replace(existing, XmlValue::Unit);
                *existing = XmlValue::Seq(vec![first, value]);
            }
        }
        return;
    }
    if let XmlValue::String(key) = &key {
        indexes.insert(key.clone(), values.len());
    }
    values.push((key, value));
}

impl<'de> Visitor<'de> for XmlValueVisitor {
    type Value = XmlValue;

    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter.write_str("an XML value")
    }

    fn visit_bool<E>(self, value: bool) -> Result<Self::Value, E> {
        Ok(XmlValue::Bool(value))
    }

    fn visit_i64<E>(self, value: i64) -> Result<Self::Value, E> {
        Ok(XmlValue::I64(value))
    }

    fn visit_u64<E>(self, value: u64) -> Result<Self::Value, E> {
        Ok(XmlValue::U64(value))
    }

    fn visit_f64<E>(self, value: f64) -> Result<Self::Value, E> {
        Ok(XmlValue::F64(value))
    }

    fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>
    where
        E: de::Error,
    {
        Ok(XmlValue::String(value.to_owned()))
    }

    fn visit_string<E>(self, value: String) -> Result<Self::Value, E> {
        Ok(XmlValue::String(value))
    }

    fn visit_unit<E>(self) -> Result<Self::Value, E> {
        Ok(XmlValue::Unit)
    }

    fn visit_none<E>(self) -> Result<Self::Value, E> {
        Ok(XmlValue::Option(None))
    }

    fn visit_some<D>(self, deserializer: D) -> Result<Self::Value, D::Error>
    where
        D: Deserializer<'de>,
    {
        Ok(XmlValue::Option(Some(Box::new(
            XmlValue::deserialize(deserializer)?,
        ))))
    }

    fn visit_seq<A>(self, mut sequence: A) -> Result<Self::Value, A::Error>
    where
        A: SeqAccess<'de>,
    {
        let mut values: Vec<XmlValue> = Vec::new();
        while let Some(value) = sequence.next_element()? {
            values.push(value);
        }
        Ok(XmlValue::Seq(values))
    }

    fn visit_map<A>(self, mut map: A) -> Result<Self::Value, A::Error>
    where
        A: MapAccess<'de>,
    {
        let mut values: Vec<(XmlValue, XmlValue)> = Vec::new();
        let mut indexes = HashMap::new();
        while let Some((key, value)) = map.next_entry()? {
            push_xml_map_entry(&mut values, &mut indexes, key, value);
        }
        Ok(XmlValue::Map(XmlMapValue { values, indexes }))
    }

    fn visit_bytes<E>(self, value: &[u8]) -> Result<Self::Value, E> {
        Ok(XmlValue::Bytes(value.to_vec()))
    }

    fn visit_byte_buf<E>(self, value: Vec<u8>) -> Result<Self::Value, E> {
        Ok(XmlValue::Bytes(value))
    }
}

#[cfg(test)]
mod xml_value_tests {
    use super::*;

    #[test]
    fn indexes_large_xml_maps_without_scanning_prior_keys() {
        XML_MAP_LOOKUP_COUNT.with(|count| count.set(0));
        let mut values = Vec::new();
        let mut indexes = HashMap::new();
        for index in 0..4096 {
            push_xml_map_entry(
                &mut values,
                &mut indexes,
                XmlValue::String(format!("key{index}")),
                XmlValue::String(format!("value{index}")),
            );
        }
        assert_eq!(4096, values.len());
        assert_eq!(4096, indexes.len());

        push_xml_map_entry(
            &mut values,
            &mut indexes,
            XmlValue::String("key2048".into()),
            XmlValue::String("duplicate".into()),
        );
        assert_eq!(4096, values.len());
        for (index, (key, value)) in values.iter().enumerate() {
            assert_eq!(&XmlValue::String(format!("key{index}")), key);
            if index != 2048 {
                assert_eq!(&XmlValue::String(format!("value{index}")), value);
            }
        }
        assert!(matches!(
            values[2048].1,
            XmlValue::Seq(ref items) if items.len() == 2
        ));
        XML_MAP_LOOKUP_COUNT.with(|count| assert_eq!(4097, count.get()));

        let map = XmlValue::Map(XmlMapValue { values, indexes });
        XML_MAP_PROBE_LOOKUP_COUNT.with(|count| count.set(0));
        for index in 0..4096 {
            assert!(map.get(&format!("key{index}")).is_some());
        }
        XML_MAP_PROBE_LOOKUP_COUNT.with(
            |count| assert_eq!(4096, count.get())
        );
    }

    #[derive(Debug, Deserialize, PartialEq)]
    struct Scalar<T> {
        value: T,
    }

    fn replay<T>(xml: &str) -> Result<T, de::value::Error>
    where
        T: serde::de::DeserializeOwned,
    {
        let buffered: Scalar<XmlValue> = quick_xml::de::from_str(xml).unwrap();
        T::deserialize(buffered.value)
    }

    #[test]
    fn replays_quick_xml_scalar_lexical_rules() {
        let spaced_number = "<Scalar><value> \t42\r\n </value></Scalar>";
        let direct: Scalar<i64> = quick_xml::de::from_str(spaced_number).unwrap();
        assert_eq!(direct.value, replay::<i64>(spaced_number).unwrap());

        for (xml, expected) in [
            ("<Scalar><value> 1 </value></Scalar>", true),
            ("<Scalar><value>\t0\r</value></Scalar>", false),
            ("<Scalar><value> true </value></Scalar>", true),
            ("<Scalar><value>false</value></Scalar>", false),
        ] {
            let direct: Scalar<bool> = quick_xml::de::from_str(xml).unwrap();
            assert_eq!(expected, direct.value);
            assert_eq!(direct.value, replay::<bool>(xml).unwrap());
        }

        let non_xml_space = "<Scalar><value>&#xA0;42&#xA0;</value></Scalar>";
        assert!(quick_xml::de::from_str::<Scalar<i64>>(non_xml_space).is_err());
        assert!(replay::<i64>(non_xml_space).is_err());

        let empty_option = "<Scalar><value/></Scalar>";
        let direct: Scalar<Option<String>> =
            quick_xml::de::from_str(empty_option).unwrap();
        assert_eq!(
            direct.value,
            replay::<Option<String>>(empty_option).unwrap(),
        );
    }

    #[derive(Debug, Deserialize, PartialEq)]
    struct Item {
        name: String,
    }

    #[derive(Debug, Deserialize, PartialEq)]
    struct EmptyItem {}

    #[derive(Debug, Deserialize, PartialEq)]
    #[serde(bound(deserialize = "T: serde::de::DeserializeOwned"))]
    struct Items<T> {
        #[serde(default)]
        item: XmlItems<T>,
    }

    fn item(name: &str) -> XmlValue {
        XmlValue::map(vec![(
            XmlValue::String("name".into()),
            XmlValue::String(name.into()),
        )])
    }

    #[test]
    fn distinguishes_absent_and_present_empty_sequence_items() {
        let empty = Items::<String>::deserialize(XmlValue::map(Vec::new()))
            .unwrap();
        assert!(empty.item.0.is_empty());

        let single_empty = Items::<String>::deserialize(XmlValue::map(vec![(
            XmlValue::String("item".into()),
            XmlValue::map(Vec::new()),
        )])).unwrap();
        assert_eq!(vec![String::new()], single_empty.item.0);

        let pair = Items::<String>::deserialize(XmlValue::map(vec![(
            XmlValue::String("item".into()),
            XmlValue::Seq(vec![
                XmlValue::map(Vec::new()),
                XmlValue::String("two".into()),
            ]),
        )])).unwrap();
        assert_eq!(vec![String::new(), "two".into()], pair.item.0);

        let empty_record = XmlItems::<EmptyItem>::deserialize(
            XmlValue::map(Vec::new()),
        ).unwrap();
        assert_eq!(1, empty_record.0.len());

        let empty_map = XmlItems::<HashMap<String, String>>::deserialize(
            XmlValue::map(Vec::new()),
        ).unwrap();
        assert_eq!(vec![HashMap::new()], empty_map.0);
    }

    #[test]
    fn replays_one_and_two_record_sequence_items() {
        let single = XmlItems::<Item>::deserialize(item("one")).unwrap();
        assert_eq!(vec![Item { name: "one".into() }], single.0);

        let pair = XmlItems::<Item>::deserialize(XmlValue::Seq(vec![
            item("one"),
            item("two"),
        ])).unwrap();
        assert_eq!(
            vec![
                Item { name: "one".into() },
                Item { name: "two".into() },
            ],
            pair.0,
        );
    }
}

impl<'de> Deserialize<'de> for XmlValue {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: Deserializer<'de>,
    {
        deserializer.deserialize_any(XmlValueVisitor)
    }
}

#[derive(Debug, PartialEq)]
pub(crate) struct XmlItems<T>(pub Vec<T>);

impl<T> Default for XmlItems<T> {
    fn default() -> Self {
        Self(Vec::new())
    }
}

impl<'de, T> Deserialize<'de> for XmlItems<T>
where
    T: serde::de::DeserializeOwned,
{
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: Deserializer<'de>,
    {
        let value = XmlValue::deserialize(deserializer)?;
        let values = match value {
            XmlValue::Seq(values) => values,
            value => vec![value],
        };
        values
            .into_iter()
            .map(T::deserialize)
            .collect::<Result<Vec<_>, _>>()
            .map(Self)
            .map_err(de::Error::custom)
    }
}

struct XmlSeqAccess {
    values: std::vec::IntoIter<XmlValue>,
}

impl<'de> SeqAccess<'de> for XmlSeqAccess {
    type Error = de::value::Error;

    fn next_element_seed<T>(
        &mut self,
        seed: T,
    ) -> Result<Option<T::Value>, Self::Error>
    where
        T: DeserializeSeed<'de>,
    {
        self.values
            .next()
            .map(|value| seed.deserialize(value))
            .transpose()
    }
}

struct XmlMapAccess {
    values: std::vec::IntoIter<(XmlValue, XmlValue)>,
    value: Option<XmlValue>,
}

impl<'de> MapAccess<'de> for XmlMapAccess {
    type Error = de::value::Error;

    fn next_key_seed<K>(
        &mut self,
        seed: K,
    ) -> Result<Option<K::Value>, Self::Error>
    where
        K: DeserializeSeed<'de>,
    {
        match self.values.next() {
            Some((key, value)) => {
                self.value = Some(value);
                seed.deserialize(key).map(Some)
            }
            None => Ok(None),
        }
    }

    fn next_value_seed<V>(&mut self, seed: V) -> Result<V::Value, Self::Error>
    where
        V: DeserializeSeed<'de>,
    {
        let value = self.value.take().ok_or_else(|| {
            de::Error::custom("XML map value requested before its key")
        })?;
        seed.deserialize(value)
    }
}

impl XmlValue {
    fn trim_xml_whitespace(value: &str) -> &str {
        value.trim_matches(|character| {
            matches!(character, ' ' | '\t' | '\r' | '\n')
        })
    }

    fn map(values: Vec<(XmlValue, XmlValue)>) -> XmlValue {
        let indexes = values.iter().enumerate().filter_map(
            |(index, (key, _))| match key {
                XmlValue::String(key) => Some((key.clone(), index)),
                _ => None,
            },
        ).collect();
        XmlValue::Map(XmlMapValue { values, indexes })
    }

    pub(crate) fn get(&self, expected: &str) -> Option<&XmlValue> {
        match self {
            XmlValue::Map(map) => {
                #[cfg(test)]
                XML_MAP_PROBE_LOOKUP_COUNT.with(
                    |count| count.set(count.get() + 1)
                );
                map.indexes.get(expected).map(
                    |index| &map.values[*index].1
                )
            }
            _ => None,
        }
    }

    pub(crate) fn contains_key(&self, expected: &str) -> bool {
        self.get(expected).is_some()
    }

    pub(crate) fn is_empty_xml_map(&self) -> bool {
        matches!(self, XmlValue::Map(map) if map.values.is_empty())
    }

    pub(crate) fn xml_text(&self) -> Option<&str> {
        match self {
            XmlValue::String(value) => Some(value),
            XmlValue::Map(map) if map.values.is_empty() => Some(""),
            XmlValue::Map(map) if map.values.len() == 1 => {
                let (key, value) = &map.values[0];
                if matches!(key, XmlValue::String(key) if key == "$text") {
                    value.xml_text()
                } else {
                    None
                }
            }
            _ => None,
        }
    }

    pub(crate) fn is_xml_text(&self) -> bool {
        self.xml_text().is_some()
    }

    pub(crate) fn is_xml_null(&self) -> bool {
        matches!(self, XmlValue::Unit | XmlValue::Option(None))
            || matches!(self, XmlValue::String(value) if value.is_empty())
    }

    pub(crate) fn is_xml_unit(&self) -> bool {
        matches!(self, XmlValue::Unit | XmlValue::String(_))
            || matches!(self, XmlValue::Map(map) if map.values.is_empty())
    }

    pub(crate) fn matches_xml_bool(&self) -> bool {
        self.xml_text().is_some_and(|text| matches!(
            Self::trim_xml_whitespace(text),
            "1" | "0" | "true" | "false"
        ))
    }

    pub(crate) fn matches_xml_number<T>(&self) -> bool
    where
        T: std::str::FromStr,
    {
        self.xml_text().is_some_and(|text| {
            Self::trim_xml_whitespace(text).parse::<T>().is_ok()
        })
    }

    pub(crate) fn matches_xml_from_str<T>(&self) -> bool
    where
        T: std::str::FromStr,
    {
        self.xml_text().is_some_and(|text| text.parse::<T>().is_ok())
    }

    pub(crate) fn xml_sequence_matches(
        &self,
        matches: impl Fn(&XmlValue) -> bool,
    ) -> bool {
        match self {
            XmlValue::Seq(values) => values.iter().all(matches),
            XmlValue::String(_) | XmlValue::Map(_) => matches(self),
            _ => false,
        }
    }

    pub(crate) fn xml_map_matches(
        &self,
        matches: impl Fn(&XmlValue) -> bool,
    ) -> bool {
        match self {
            XmlValue::Map(map) => map.values.iter().all(|(key, value)| {
                matches!(key, XmlValue::String(_)) && matches(value)
            }),
            _ => false,
        }
    }

    fn into_text(self) -> Result<String, de::value::Error> {
        match self {
            XmlValue::String(value) => Ok(value),
            XmlValue::Map(map) if map.values.is_empty() => {
                Ok(String::new())
            }
            XmlValue::Map(mut map) if map.values.len() == 1 => {
                let (key, value) = map.values.pop().unwrap();
                if matches!(key, XmlValue::String(ref key) if key == "$text") {
                    value.into_text()
                } else {
                    Err(de::Error::custom("expected XML text"))
                }
            }
            _ => Err(de::Error::custom("expected XML text")),
        }
    }

    fn parse<T>(self) -> Result<T, de::value::Error>
    where
        T: std::str::FromStr,
        T::Err: fmt::Display,
    {
        let text = self.into_text()?;
        Self::trim_xml_whitespace(&text)
            .parse()
            .map_err(de::Error::custom)
    }
}

macro_rules! deserialize_number {
    ($method:ident, $visit:ident, $type:ty) => {
        fn $method<V>(self, visitor: V) -> Result<V::Value, Self::Error>
        where
            V: Visitor<'de>,
        {
            visitor.$visit(self.parse::<$type>()?)
        }
    };
}

impl<'de> Deserializer<'de> for XmlValue {
    type Error = de::value::Error;

    fn deserialize_any<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        match self {
            XmlValue::Bool(value) => visitor.visit_bool(value),
            XmlValue::I64(value) => visitor.visit_i64(value),
            XmlValue::U64(value) => visitor.visit_u64(value),
            XmlValue::F64(value) => visitor.visit_f64(value),
            XmlValue::String(value) => visitor.visit_string(value),
            XmlValue::Unit => visitor.visit_unit(),
            XmlValue::Option(None) => visitor.visit_none(),
            XmlValue::Option(Some(value)) => visitor.visit_some(*value),
            XmlValue::Seq(values) => {
                visitor.visit_seq(XmlSeqAccess {
                    values: values.into_iter(),
                })
            }
            XmlValue::Map(map) => {
                visitor.visit_map(XmlMapAccess {
                    values: map.values.into_iter(),
                    value: None,
                })
            }
            XmlValue::Bytes(value) => visitor.visit_byte_buf(value),
        }
    }

    fn deserialize_bool<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        let text = self.into_text()?;
        let value = match XmlValue::trim_xml_whitespace(&text) {
            "1" => true,
            "0" => false,
            text => text.parse().map_err(de::Error::custom)?,
        };
        visitor.visit_bool(value)
    }

    deserialize_number!(deserialize_i8, visit_i8, i8);
    deserialize_number!(deserialize_i16, visit_i16, i16);
    deserialize_number!(deserialize_i32, visit_i32, i32);
    deserialize_number!(deserialize_i64, visit_i64, i64);
    deserialize_number!(deserialize_i128, visit_i128, i128);
    deserialize_number!(deserialize_u8, visit_u8, u8);
    deserialize_number!(deserialize_u16, visit_u16, u16);
    deserialize_number!(deserialize_u32, visit_u32, u32);
    deserialize_number!(deserialize_u64, visit_u64, u64);
    deserialize_number!(deserialize_u128, visit_u128, u128);
    deserialize_number!(deserialize_f32, visit_f32, f32);
    deserialize_number!(deserialize_f64, visit_f64, f64);

    fn deserialize_char<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_char(self.parse::<char>()?)
    }

    fn deserialize_str<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_string(self.into_text()?)
    }

    fn deserialize_string<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_string(self.into_text()?)
    }

    fn deserialize_bytes<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        match self {
            XmlValue::Bytes(value) => visitor.visit_byte_buf(value),
            XmlValue::String(value) => visitor.visit_byte_buf(value.into_bytes()),
            other => other.deserialize_seq(visitor),
        }
    }

    fn deserialize_byte_buf<V>(
        self,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_bytes(visitor)
    }

    fn deserialize_option<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        match self {
            XmlValue::Option(None) | XmlValue::Unit => visitor.visit_none(),
            XmlValue::Option(Some(value)) => visitor.visit_some(*value),
            XmlValue::String(value) if value.is_empty() => visitor.visit_none(),
            value => visitor.visit_some(value),
        }
    }

    fn deserialize_unit<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        match self {
            XmlValue::Unit | XmlValue::String(_) => visitor.visit_unit(),
            XmlValue::Map(map) if map.values.is_empty() => visitor.visit_unit(),
            _ => Err(de::Error::custom("expected empty XML value")),
        }
    }

    fn deserialize_unit_struct<V>(
        self,
        _name: &'static str,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_unit(visitor)
    }

    fn deserialize_newtype_struct<V>(
        self,
        _name: &'static str,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_newtype_struct(self)
    }

    fn deserialize_seq<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        let values = match self {
            XmlValue::Seq(values) => values,
            XmlValue::Map(map) if map.values.is_empty() => Vec::new(),
            XmlValue::Map(map) => vec![XmlValue::Map(map)],
            value @ XmlValue::String(_) => vec![value],
            _ => return Err(de::Error::custom("expected XML sequence")),
        };
        visitor.visit_seq(XmlSeqAccess {
            values: values.into_iter(),
        })
    }

    fn deserialize_tuple<V>(
        self,
        _length: usize,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_seq(visitor)
    }

    fn deserialize_tuple_struct<V>(
        self,
        _name: &'static str,
        _length: usize,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_seq(visitor)
    }

    fn deserialize_map<V>(self, visitor: V) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        match self {
            XmlValue::Map(map) => visitor.visit_map(XmlMapAccess {
                values: map.values.into_iter(),
                value: None,
            }),
            _ => Err(de::Error::custom("expected XML map")),
        }
    }

    fn deserialize_struct<V>(
        self,
        _name: &'static str,
        _fields: &'static [&'static str],
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_map(visitor)
    }

    fn deserialize_enum<V>(
        self,
        _name: &'static str,
        _variants: &'static [&'static str],
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_enum(self.into_text()?.into_deserializer())
    }

    fn deserialize_identifier<V>(
        self,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        self.deserialize_string(visitor)
    }

    fn deserialize_ignored_any<V>(
        self,
        visitor: V,
    ) -> Result<V::Value, Self::Error>
    where
        V: Visitor<'de>,
    {
        visitor.visit_unit()
    }
}

thread_local! {
    static XML_UNION_PROBE_DEPTH: Cell<usize> = const { Cell::new(0) };
    static XML_UNION_DESERIALIZE_DEPTH: Cell<usize> = const { Cell::new(0) };
    #[cfg(test)]
    static XML_UNION_SERIALIZATION_PROBE_COUNT: Cell<usize> =
        const { Cell::new(0) };
}

#[cfg(test)]
pub(crate) fn record_xml_union_serialization_probe() {
    XML_UNION_SERIALIZATION_PROBE_COUNT.with(
        |count| count.set(count.get() + 1)
    );
}

#[cfg(test)]
pub(crate) fn reset_xml_union_serialization_probe_count() {
    XML_UNION_SERIALIZATION_PROBE_COUNT.with(|count| count.set(0));
}

#[cfg(test)]
pub(crate) fn xml_union_serialization_probe_count() -> usize {
    XML_UNION_SERIALIZATION_PROBE_COUNT.with(Cell::get)
}

pub(crate) fn xml_union_probe_active() -> bool {
    XML_UNION_PROBE_DEPTH.with(|depth| depth.get() != 0)
}

pub(crate) fn xml_union_deserialize_active() -> bool {
    XML_UNION_DESERIALIZE_DEPTH.with(|depth| depth.get() != 0)
}

pub(crate) fn with_xml_union_deserialize<T, E>(
    deserialize: impl FnOnce() -> Result<T, E>,
) -> Result<T, E> {
    XML_UNION_DESERIALIZE_DEPTH.with(|depth| {
        struct RestoreDepth<'a> {
            depth: &'a Cell<usize>,
            previous: usize,
        }

        impl Drop for RestoreDepth<'_> {
            fn drop(&mut self) {
                self.depth.set(self.previous);
            }
        }

        let previous = depth.get();
        depth.set(previous + 1);
        let _restore = RestoreDepth { depth, previous };
        deserialize()
    })
}

pub(crate) fn with_xml_union_probe<T, E>(
    probe: impl FnOnce() -> Result<T, E>,
) -> Result<T, E> {
    XML_UNION_PROBE_DEPTH.with(|depth| {
        struct RestoreDepth<'a> {
            depth: &'a Cell<usize>,
            previous: usize,
        }

        impl Drop for RestoreDepth<'_> {
            fn drop(&mut self) {
                self.depth.set(self.previous);
            }
        }

        let previous = depth.get();
        depth.set(previous + 1);
        let _restore = RestoreDepth { depth, previous };
        probe()
    })
}

fn invalid_data(message: impl Into<String>) -> Box<dyn std::error::Error> {
    std::io::Error::new(std::io::ErrorKind::InvalidData, message.into()).into()
}

pub(crate) fn decode_data(
    data: &[u8],
    gzip: bool,
    enforce_limit: bool,
) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
    if enforce_limit && data.len() > MAX_XML_DATA_SIZE {
        return Err(invalid_data("input exceeds the generated data size limit"));
    }
    if !gzip {
        return Ok(data.to_vec());
    }

    let decoder = GzDecoder::new(data);
    let mut decompressed = Vec::new();
    if enforce_limit {
        decoder
            .take((MAX_XML_DATA_SIZE + 1) as u64)
            .read_to_end(&mut decompressed)?;
    } else {
        decoder.take(u64::MAX).read_to_end(&mut decompressed)?;
    }
    if enforce_limit && decompressed.len() > MAX_XML_DATA_SIZE {
        return Err(invalid_data("decompressed input exceeds the generated data size limit"));
    }
    Ok(decompressed)
}

fn validate_attributes(
    start: &BytesStart<'_>,
    allowed_attributes: &[&str],
    owner: Option<&str>,
    attribute_owners: &[(&str, &str)],
) -> Result<Option<String>, Box<dyn std::error::Error>> {
    let raw_name = start.name();
    let raw_name = std::str::from_utf8(raw_name.as_ref())?;
    let namespace_attribute = raw_name
        .split_once(':')
        .map(|(prefix, _)| format!("xmlns:{prefix}"))
        .unwrap_or_else(|| "xmlns".to_string());
    let mut namespace = None;

    for attribute in start.attributes().with_checks(true) {
        let attribute = attribute?;
        let key = std::str::from_utf8(attribute.key.as_ref())?;
        let value = attribute.unescape_value()?.into_owned();
        if key == namespace_attribute {
            namespace = Some(value);
        }
        if key != "xmlns"
            && !key.starts_with("xmlns:")
            && (!allowed_attributes.contains(&key)
                || owner.map_or(false, |owner| !attribute_owners.contains(&(owner, key))))
        {
            return Err(invalid_data(format!("unknown XML attribute: {key}")));
        }
    }
    Ok(namespace)
}

fn validate_root(
    start: &BytesStart<'_>,
    namespace: &str,
    expected_root: &str,
    expected_namespace: &str,
    allowed_attributes: &[&str],
) -> Result<(), Box<dyn std::error::Error>> {
    let local_name = start.local_name();
    let local_name = std::str::from_utf8(local_name.as_ref())?;
    if local_name != expected_root {
        return Err(invalid_data(format!(
            "unexpected XML root: expected {expected_root}, found {local_name}"
        )));
    }
    validate_attributes(start, allowed_attributes, None, &[])?;
    if namespace != expected_namespace {
        return Err(invalid_data(format!(
            "unexpected XML namespace: expected {expected_namespace}, found {namespace}"
        )));
    }
    Ok(())
}

fn validate_root_child(
    start: &BytesStart<'_>,
    fields: &[(&str, bool, bool)],
    seen: &mut HashSet<String>,
) -> Result<bool, Box<dyn std::error::Error>> {
    let local_name = start.local_name();
    let local_name = std::str::from_utf8(local_name.as_ref())?;
    let (_, repeatable, map) = match fields
        .iter()
        .find(|(name, _, _)| *name == local_name)
    {
        Some(field) => field,
        None => return Err(invalid_data(format!(
            "unknown XML element: {local_name}"
        ))),
    };
    if !repeatable && !seen.insert(local_name.to_string()) {
        return Err(invalid_data(format!("duplicate XML element: {local_name}")));
    }
    Ok(*map)
}

fn validate_element_namespace(
    parent: &str,
    element: &str,
    namespace: &str,
    element_namespaces: &[(&str, &str, &str)],
) -> Result<(), Box<dyn std::error::Error>> {
    let mut expected = element_namespaces
        .iter()
        .filter(|(expected_parent, expected_element, _)| {
            *expected_parent == parent && *expected_element == element
        })
        .peekable();
    if expected.peek().is_some() && !expected.any(|(_, _, expected_namespace)| *expected_namespace == namespace) {
        return Err(invalid_data(format!(
            "unexpected XML namespace for {element}: found {namespace}"
        )));
    }
    Ok(())
}

fn resolved_namespace(
    resolution: ResolveResult<'_>,
) -> Result<String, Box<dyn std::error::Error>> {
    match resolution {
        ResolveResult::Unbound => Ok(String::new()),
        ResolveResult::Bound(namespace) => {
            Ok(std::str::from_utf8(namespace.as_ref())?.to_string())
        }
        ResolveResult::Unknown(prefix) => Err(invalid_data(format!(
            "unknown XML namespace prefix: {}",
            String::from_utf8_lossy(&prefix)
        ))),
    }
}

pub(crate) fn validate_xml_document(
    data: &[u8],
    expected_root: &str,
    expected_namespace: &str,
    fields: &[(&str, bool, bool)],
    attributes: &[&str],
    descendant_fields: &[&str],
    descendant_attributes: &[&str],
    map_fields: &[&str],
    descendant_relationships: &[(&str, &str)],
    element_namespaces: &[(&str, &str, &str)],
    attribute_owners: &[(&str, &str)],
) -> Result<(), Box<dyn std::error::Error>> {
    if data.len() > MAX_XML_DATA_SIZE {
        return Err(invalid_data("XML input exceeds the generated data size limit"));
    }

    let mut reader = NsReader::from_reader(data);
    reader.config_mut().trim_text(false);
    let mut depth = 0usize;
    let mut root_seen = false;
    let mut root_closed = false;
    let mut seen_root_fields = HashSet::new();
    let mut active_map_depth = None;
    let mut map_keys = HashSet::new();
    let mut element_stack: Vec<String> = Vec::new();

    loop {
        let (resolution, event) = reader.read_resolved_event()?;
        let namespace = resolved_namespace(resolution)?;
        match event {
            Event::Start(start) => {
                if depth == 0 {
                    if root_seen || root_closed {
                        return Err(invalid_data("XML must contain exactly one root element"));
                    }
                    validate_root(
                        &start,
                        &namespace,
                        expected_root,
                        expected_namespace,
                        attributes,
                    )?;
                    root_seen = true;
                    element_stack.push(expected_root.to_string());
                } else {
                    let local_name =
                        std::str::from_utf8(start.local_name().as_ref())?.to_string();
                    let parent = element_stack.last().cloned().unwrap_or_default();
                    let attribute_owner =
                        active_map_depth.is_none().then_some(local_name.as_str());
                    validate_attributes(
                        &start,
                        descendant_attributes,
                        attribute_owner,
                        attribute_owners,
                    )?;
                    if depth == 1 {
                        if validate_root_child(&start, fields, &mut seen_root_fields)? {
                            active_map_depth = Some(depth + 1);
                            map_keys.clear();
                        }
                    } else if active_map_depth == Some(depth) {
                        if !map_keys.insert(local_name.clone()) {
                            return Err(invalid_data(format!(
                                "duplicate XML map key: {local_name}"
                            )));
                        }
                    } else if active_map_depth.is_none() {
                        if !descendant_fields.contains(&local_name.as_str())
                            || !descendant_relationships
                                .contains(&(parent.as_str(), local_name.as_str()))
                        {
                            return Err(invalid_data(format!(
                                "unknown XML element: {local_name}"
                            )));
                        }
                    }
                    let namespace_parent = if depth == 1 { "" } else { parent.as_str() };
                    validate_element_namespace(
                        namespace_parent,
                        &local_name,
                        &namespace,
                        element_namespaces,
                    )?;
                    if active_map_depth.is_none() && map_fields.contains(&local_name.as_str()) {
                        active_map_depth = Some(depth + 1);
                        map_keys.clear();
                    }
                    element_stack.push(local_name);
                }
                depth += 1;
                if depth > MAX_XML_DEPTH {
                    return Err(invalid_data("XML nesting depth exceeds the generated limit"));
                }
            }
            Event::Empty(start) => {
                if depth == 0 {
                    if root_seen || root_closed {
                        return Err(invalid_data("XML must contain exactly one root element"));
                    }
                    validate_root(
                        &start,
                        &namespace,
                        expected_root,
                        expected_namespace,
                        attributes,
                    )?;
                    root_seen = true;
                    root_closed = true;
                } else {
                    let local_name =
                        std::str::from_utf8(start.local_name().as_ref())?.to_string();
                    let parent = element_stack.last().cloned().unwrap_or_default();
                    let attribute_owner =
                        active_map_depth.is_none().then_some(local_name.as_str());
                    validate_attributes(
                        &start,
                        descendant_attributes,
                        attribute_owner,
                        attribute_owners,
                    )?;
                    if depth == 1 {
                        validate_root_child(&start, fields, &mut seen_root_fields)?;
                    } else if active_map_depth == Some(depth) {
                        if !map_keys.insert(local_name.clone()) {
                            return Err(invalid_data(format!(
                                "duplicate XML map key: {local_name}"
                            )));
                        }
                    } else if active_map_depth.is_none() {
                        if !descendant_fields.contains(&local_name.as_str())
                            || !descendant_relationships
                                .contains(&(parent.as_str(), local_name.as_str()))
                        {
                            return Err(invalid_data(format!(
                                "unknown XML element: {local_name}"
                            )));
                        }
                    }
                    let namespace_parent = if depth == 1 { "" } else { parent.as_str() };
                    validate_element_namespace(
                        namespace_parent,
                        &local_name,
                        &namespace,
                        element_namespaces,
                    )?;
                }
            }
            Event::End(_) => {
                if depth == 0 {
                    return Err(invalid_data("unexpected XML closing element"));
                }
                if active_map_depth == Some(depth) {
                    active_map_depth = None;
                    map_keys.clear();
                }
                element_stack.pop();
                depth -= 1;
                if depth == 0 {
                    root_closed = true;
                }
            }
            Event::DocType(_) => {
                return Err(invalid_data("DOCTYPE declarations are not allowed"));
            }
            Event::Text(text) if depth == 0 && !text.as_ref().iter().all(u8::is_ascii_whitespace) => {
                return Err(invalid_data("text outside the XML root is not allowed"));
            }
            Event::Eof => break,
            _ => {}
        }
    }

    if !root_seen || !root_closed || depth != 0 {
        return Err(invalid_data("XML document is incomplete"));
    }
    Ok(())
}
