{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clemensv/avrotize/schemas/issue-semantic-assistance.schema.json",
  "title": "Issue Semantic Assistance",
  "description": "Strict read-only Copilot suggestion shape for maintainer issue intake.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "report_kind",
    "candidates",
    "missing_details",
    "duplicate_search_terms",
    "needs_human_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "report_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "evidence"
      ],
      "properties": {
        "value": {
          "enum": [
            "bug",
            "feature",
            "question",
            "other",
            "uncertain"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "area",
          "command",
          "confidence",
          "evidence"
        ],
        "properties": {
          "surface": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "area": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "missing_details": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "duplicate_search_terms": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "needs_human_review": {
      "type": "boolean"
    }
  }
}
