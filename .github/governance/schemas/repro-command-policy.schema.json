{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clemensv/avrotize/schemas/repro-command-policy.schema.json",
  "title": "Guarded Reproduction Command Policy",
  "description": "Structure of the explicit allowlist that bounds which Avrotize CLI commands guarded reproduction may execute.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "description",
    "authority_statement",
    "limits",
    "eligible_surfaces",
    "executables",
    "reserved_option_names",
    "commands",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authority_statement": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_fixture_bytes",
        "max_stream_bytes",
        "max_produced_files",
        "max_produced_bytes",
        "max_invocation_tokens",
        "max_option_value_length"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_fixture_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_stream_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        },
        "max_produced_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_produced_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_invocation_tokens": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        },
        "max_option_value_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "eligible_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      }
    },
    "reserved_option_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^--[a-z][a-z0-9-]*$"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "reason"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "executable",
        "description",
        "rationale",
        "input_mode",
        "input_extension",
        "input_option_aliases",
        "output_mode",
        "timeout_seconds",
        "reporter_options"
      ],
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,15}$"
        },
        "executable": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "input_mode": {
          "enum": [
            "positional"
          ]
        },
        "input_extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9.]{1,20}$"
        },
        "input_option_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^--[a-z][a-z0-9-]*$"
          }
        },
        "output_mode": {
          "enum": [
            "option",
            "stdout"
          ]
        },
        "output_option": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "output_extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9.]{1,20}$"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "reporter_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reporter_option"
          }
        }
      }
    },
    "reporter_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "flag",
            "choice",
            "string"
          ]
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
