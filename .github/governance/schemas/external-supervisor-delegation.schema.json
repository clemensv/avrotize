{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clemensv/avrotize/.github/governance/schemas/external-supervisor-delegation.schema.json",
  "title": "Avrotize external supervisor owner delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "delegation_id",
    "repository",
    "authenticated_owner_login",
    "initial_cycle_id",
    "authorized_at",
    "expires_at",
    "policy_binding",
    "scope",
    "allowed_actions",
    "denied_owner_only_actions",
    "limits",
    "revocation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_kind": {
      "const": "external-supervisor-delegation"
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^delegation-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "authenticated_owner_login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "initial_cycle_id": {
      "type": "string",
      "pattern": "^cycle-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "authorized_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "policy_binding": {
      "$ref": "#/$defs/policy_binding"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "pull_requests",
        "domains",
        "ready_order"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pull_requests": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "ready_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ready_item"
          }
        }
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/delegable_action"
      }
    },
    "denied_owner_only_actions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/owner_only_action"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_active_per_domain",
        "max_child_sessions",
        "max_session_creations",
        "max_redirects_per_item",
        "max_cycle_seconds",
        "max_snapshot_age_seconds",
        "platform_reported_aic_guardrail"
      ],
      "properties": {
        "max_active_per_domain": {
          "const": 1
        },
        "max_child_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_session_creations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_redirects_per_item": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_cycle_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "max_snapshot_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "platform_reported_aic_guardrail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "max_aic",
            "source"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_aic": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "source": {
              "const": "github-copilot-platform"
            }
          }
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revoked",
        "revoked_at",
        "reason"
      ],
      "properties": {
        "revoked": {
          "type": "boolean"
        },
        "revoked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "blob_sha256",
        "policy_path"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_path": {
          "const": ".github/governance/external-supervisor-policy.json"
        }
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "avrotize-schema-and-json-structure-semantics",
        "schema-and-idl-transformations",
        "programming-language-model-generation",
        "database-and-analytical-schemas",
        "data-inference-and-validation",
        "command-access-and-distribution"
      ]
    },
    "acceptance_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "source_ref",
        "frozen_at"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "frozen_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "ready_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "issue_number",
        "pull_request",
        "domain",
        "dependencies",
        "acceptance_manifest"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "acceptance_manifest": {
          "$ref": "#/$defs/acceptance_manifest"
        }
      }
    },
    "delegable_action": {
      "type": "string",
      "enum": [
        "select-owner-approved-ready-item",
        "create-isolated-child-session",
        "resume-isolated-child-session",
        "send-bounded-child-instructions",
        "redirect-child-session",
        "replace-child-session",
        "open-scoped-pull-request",
        "update-scoped-pull-request",
        "publish-scoped-evidence",
        "request-review",
        "record-cycle-and-recovery-evidence"
      ]
    },
    "owner_only_action": {
      "type": "string",
      "enum": [
        "set-backlog-rank",
        "set-priority",
        "authorize-ready",
        "change-acceptance-manifest",
        "grant-wip-exception",
        "approve-compatibility-exception",
        "approve-risk-exception",
        "approve-emergency-exception",
        "approve-pull-request",
        "merge",
        "tag-release",
        "publish-release",
        "grant-delegation",
        "amend-delegation",
        "revoke-delegation"
      ]
    }
  }
}
