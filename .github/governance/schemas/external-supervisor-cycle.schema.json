{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clemensv/avrotize/.github/governance/schemas/external-supervisor-cycle.schema.json",
  "title": "Avrotize external supervisor durable records",
  "oneOf": [
    {
      "$ref": "#/$defs/cycle_record"
    },
    {
      "$ref": "#/$defs/dispatch_record"
    },
    {
      "$ref": "#/$defs/recovery_record"
    },
    {
      "$ref": "#/$defs/owner_decision_record"
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha1": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "avrotize-schema-and-json-structure-semantics",
        "schema-and-idl-transformations",
        "programming-language-model-generation",
        "database-and-analytical-schemas",
        "data-inference-and-validation",
        "command-access-and-distribution"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "INTAKE",
        "READY",
        "ACTIVE",
        "REVIEW",
        "APPROVED",
        "MERGED",
        "RELEASED",
        "BLOCKED",
        "PARKED",
        "INDETERMINATE"
      ]
    },
    "session_state": {
      "type": "string",
      "enum": [
        "PLANNED",
        "DISPATCH_REQUIRED",
        "DISPATCHED",
        "RUNNING",
        "IDLE",
        "EVIDENCE_READY",
        "REVIEW_WAIT",
        "REDIRECT_REQUIRED",
        "BLOCKED",
        "FAILED",
        "CLOSED",
        "UNKNOWN",
        "INDETERMINATE",
        "REVOKED"
      ]
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "blob_sha256"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "delegation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "path",
        "blob_sha256"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "path": {
          "type": "string",
          "minLength": 6,
          "maxLength": 300,
          "pattern": "^[^/][A-Za-z0-9._/-]*\\.json$"
        },
        "blob_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pending_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "decision_id",
        "issue_number",
        "dispatch_packet_digest"
      ],
      "properties": {
        "cycle_id": {
          "type": "string",
          "pattern": "^cycle-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "dispatch_packet_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "owner_only_action": {
      "type": "string",
      "enum": [
        "set-backlog-rank",
        "set-priority",
        "authorize-ready",
        "change-acceptance-manifest",
        "grant-wip-exception",
        "approve-compatibility-exception",
        "approve-risk-exception",
        "approve-emergency-exception",
        "approve-pull-request",
        "merge",
        "tag-release",
        "publish-release",
        "grant-delegation",
        "amend-delegation",
        "revoke-delegation"
      ]
    },
    "delegable_action": {
      "type": "string",
      "enum": [
        "select-owner-approved-ready-item",
        "create-isolated-child-session",
        "resume-isolated-child-session",
        "send-bounded-child-instructions",
        "redirect-child-session",
        "replace-child-session",
        "open-scoped-pull-request",
        "update-scoped-pull-request",
        "publish-scoped-evidence",
        "request-review",
        "record-cycle-and-recovery-evidence"
      ]
    },
    "allowed_tool": {
      "type": "string",
      "enum": [
        "repository-read",
        "scoped-repository-edit",
        "test-runner",
        "scoped-git-commit",
        "scoped-git-push-broker",
        "project-session-messaging"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory",
        "delegated_operational",
        "owner_only_actions_denied",
        "scope_issues",
        "scope_pull_requests"
      ],
      "properties": {
        "advisory": {
          "const": true
        },
        "delegated_operational": {
          "type": "boolean"
        },
        "owner_only_actions_denied": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner_only_action"
          }
        },
        "scope_issues": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "scope_pull_requests": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_digest",
        "snapshot_digest",
        "snapshot_observed_at",
        "session_inventory_digest",
        "previous_record_digest",
        "recovery_record_digest"
      ],
      "properties": {
        "delegation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "session_inventory_digest": {
          "$ref": "#/$defs/sha256"
        },
        "previous_record_digest": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "recovery_record_digest": {
          "$ref": "#/$defs/nullable_sha256"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable",
        "payload_digest",
        "supersedes"
      ],
      "properties": {
        "immutable": {
          "const": true
        },
        "payload_digest": {
          "$ref": "#/$defs/sha256"
        },
        "supersedes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "lifecycle_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_number",
        "pull_request",
        "domain",
        "observed_state",
        "head_sha",
        "evidence_head_sha",
        "approval_head_sha"
      ],
      "properties": {
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "observed_state": {
          "$ref": "#/$defs/lifecycle_state"
        },
        "head_sha": {
          "$ref": "#/$defs/nullable_sha1"
        },
        "evidence_head_sha": {
          "$ref": "#/$defs/nullable_sha1"
        },
        "approval_head_sha": {
          "$ref": "#/$defs/nullable_sha1"
        }
      }
    },
    "worker_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "delegation_id",
        "policy_commit",
        "issue_number",
        "role",
        "state",
        "head_sha",
        "cycle_record_digest",
        "dispatch_packet_digest",
        "branch_ref",
        "dirty",
        "executing",
        "redirects"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "policy_commit": {
          "$ref": "#/$defs/sha1"
        },
        "issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "role": {
          "enum": [
            "worker",
            "reviewer",
            "supervisor"
          ]
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "head_sha": {
          "$ref": "#/$defs/nullable_sha1"
        },
        "cycle_record_digest": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "dispatch_packet_digest": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "branch_ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
        },
        "dirty": {
          "type": "boolean"
        },
        "executing": {
          "type": "boolean"
        },
        "redirects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dispatch_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_id",
        "delegation_digest",
        "delegation_binding",
        "policy_binding",
        "cycle_id",
        "decision_id",
        "target_session_id",
        "repository",
        "issue_number",
        "pull_request",
        "base_sha",
        "head_sha",
        "launch_head_sha",
        "domain",
        "wip_slot",
        "acceptance_manifest_digest",
        "required_evidence",
        "allowed_tools",
        "mutation_constraints",
        "allowed_mutations",
        "budgets",
        "expected_output",
        "prohibitions",
        "fail_states"
      ],
      "properties": {
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "delegation_binding": {
          "$ref": "#/$defs/delegation_binding"
        },
        "policy_binding": {
          "$ref": "#/$defs/policy_binding"
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^cycle-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "target_session_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "base_sha": {
          "$ref": "#/$defs/sha1"
        },
        "head_sha": {
          "$ref": "#/$defs/nullable_sha1"
        },
        "launch_head_sha": {
          "$ref": "#/$defs/sha1"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "wip_slot": {
          "const": 1
        },
        "acceptance_manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "positive",
              "invalid",
              "boundary",
              "compatibility",
              "generated-runtime"
            ]
          }
        },
        "allowed_tools": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/allowed_tool"
          }
        },
        "mutation_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_branch_ref",
            "expected_old_sha",
            "denied_ref_prefixes",
            "force_push"
          ],
          "properties": {
            "allowed_branch_ref": {
              "type": "string",
              "pattern": "^refs/heads/copilot-supervisor/issue-[1-9][0-9]*-[0-9a-f]{12}$"
            },
            "expected_old_sha": {
              "$ref": "#/$defs/sha1"
            },
            "denied_ref_prefixes": {
              "const": [
                "refs/heads/master",
                "refs/heads/main",
                "refs/tags/"
              ]
            },
            "force_push": {
              "const": false
            }
          }
        },
        "allowed_mutations": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/delegable_action"
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_child_sessions",
            "max_session_creations",
            "max_redirects_per_item",
            "max_cycle_seconds",
            "max_snapshot_age_seconds",
            "max_platform_reported_aic"
          ],
          "properties": {
            "max_child_sessions": {
              "type": "integer",
              "minimum": 1
            },
            "max_session_creations": {
              "type": "integer",
              "minimum": 1
            },
            "max_redirects_per_item": {
              "type": "integer",
              "minimum": 0
            },
            "max_cycle_seconds": {
              "type": "integer",
              "minimum": 60
            },
            "max_snapshot_age_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_platform_reported_aic": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "expected_output": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "commit-sha",
              "changed-paths",
              "commands-and-results",
              "evidence-artifacts",
              "unresolved-risks",
              "exact-head-status"
            ]
          }
        },
        "prohibitions": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner_only_action"
          }
        },
        "fail_states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BLOCKED",
              "STALE_HEAD",
              "OUT_OF_SCOPE",
              "INDETERMINATE"
            ]
          }
        }
      }
    },
    "cycle_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "state",
        "reason_code",
        "selected_issue_number",
        "domain",
        "action",
        "dispatch_packet",
        "owner_decision_required",
        "owner_decisions_allowed"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
        },
        "selected_issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/domain"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "NONE",
            "CREATE_CHILD",
            "RESUME_CHILD",
            "REDIRECT_CHILD",
            "REPLACE_CHILD",
            "REQUEST_REVIEW"
          ]
        },
        "dispatch_packet": {
          "anyOf": [
            {
              "$ref": "#/$defs/dispatch_packet"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_decision_required": {
          "type": "boolean"
        },
        "owner_decisions_allowed": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner_only_action"
          }
        }
      }
    },
    "budget_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_child_sessions",
        "session_creations_used",
        "redirects_used",
        "redirect_counts",
        "elapsed_seconds",
        "platform_reported_aic"
      ],
      "properties": {
        "active_child_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "session_creations_used": {
          "type": "integer",
          "minimum": 0
        },
        "redirects_used": {
          "type": "integer",
          "minimum": 0
        },
        "redirect_counts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue_number",
              "count"
            ],
            "properties": {
              "issue_number": {
                "type": "integer",
                "minimum": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "platform_reported_aic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported",
            "value",
            "measurement_scope"
          ],
          "properties": {
            "reported": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "measurement_scope": {
              "const": "current-cycle-total"
            }
          }
        }
      }
    },
    "cycle_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "cycle_id",
        "sequence",
        "created_at",
        "repository",
        "delegation_id",
        "delegation_binding",
        "policy_binding",
        "input_binding",
        "authority",
        "repository_lifecycle",
        "execution",
        "decision",
        "pending_dispatch",
        "budget",
        "audit"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_kind": {
          "const": "external-supervisor-cycle"
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^cycle-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_binding": {
          "$ref": "#/$defs/delegation_binding"
        },
        "policy_binding": {
          "$ref": "#/$defs/policy_binding"
        },
        "input_binding": {
          "$ref": "#/$defs/input_binding"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "repository_lifecycle": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/lifecycle_item"
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supervisor_session_id",
            "state",
            "worker_sessions"
          ],
          "properties": {
            "supervisor_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "state": {
              "$ref": "#/$defs/session_state"
            },
            "worker_sessions": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/worker_session"
              }
            }
          }
        },
        "decision": {
          "$ref": "#/$defs/cycle_decision"
        },
        "pending_dispatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending_dispatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "$ref": "#/$defs/budget_status"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      }
    },
    "dispatch_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "receipt_id",
        "created_at",
        "delegation_id",
        "delegation_digest",
        "delegation_binding",
        "policy_binding",
        "cycle_id",
        "decision_id",
        "cycle_record_digest",
        "dispatch_packet_digest",
        "dispatched_head_sha",
        "dispatched_branch_ref",
        "child_session_id",
        "issue_number",
        "state",
        "executing",
        "session_inventory_digest",
        "audit"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_kind": {
          "const": "external-supervisor-dispatch"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^receipt-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "delegation_binding": {
          "$ref": "#/$defs/delegation_binding"
        },
        "policy_binding": {
          "$ref": "#/$defs/policy_binding"
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "cycle_record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dispatch_packet_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dispatched_head_sha": {
          "$ref": "#/$defs/sha1"
        },
        "dispatched_branch_ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
        },
        "child_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "const": "RUNNING"
        },
        "executing": {
          "const": true
        },
        "session_inventory_digest": {
          "$ref": "#/$defs/sha256"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      }
    },
    "recovery_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "recovery_id",
        "created_at",
        "delegation_id",
        "delegation_digest",
        "delegation_binding",
        "policy_binding",
        "cause",
        "pending_dispatch",
        "session_inventory_digest",
        "session_inventory_observed_at",
        "previous_record_digests",
        "reconstructed_from",
        "parked_and_failed_history_preserved",
        "state",
        "audit"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_kind": {
          "const": "external-supervisor-recovery"
        },
        "recovery_id": {
          "type": "string",
          "pattern": "^recovery-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "delegation_binding": {
          "$ref": "#/$defs/delegation_binding"
        },
        "policy_binding": {
          "$ref": "#/$defs/policy_binding"
        },
        "cause": {
          "enum": [
            "CRASH_RESTART",
            "STALE_SESSION",
            "FAILED_CHILD",
            "AUDIT_RECONCILIATION"
          ]
        },
        "pending_dispatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending_dispatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_inventory_digest": {
          "$ref": "#/$defs/sha256"
        },
        "session_inventory_observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "previous_record_digests": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "reconstructed_from": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "delegation",
              "cycle-records",
              "github-facts",
              "git-state",
              "session-inventory"
            ]
          }
        },
        "parked_and_failed_history_preserved": {
          "const": true
        },
        "state": {
          "$ref": "#/$defs/session_state"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      }
    },
    "owner_decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_kind",
        "packet_id",
        "created_at",
        "delegation_id",
        "delegation_digest",
        "delegation_binding",
        "policy_binding",
        "source_cycle_id",
        "source_cycle_digest",
        "source_decision_id",
        "observed_lifecycle",
        "reason",
        "issue_number",
        "pull_request",
        "exact_head_sha",
        "requested_owner_decisions",
        "supervisor_made_decision",
        "audit"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_kind": {
          "const": "external-supervisor-owner-decision-packet"
        },
        "packet_id": {
          "type": "string",
          "pattern": "^owner-packet-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "delegation_id": {
          "type": "string",
          "minLength": 1
        },
        "delegation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "delegation_binding": {
          "$ref": "#/$defs/delegation_binding"
        },
        "policy_binding": {
          "$ref": "#/$defs/policy_binding"
        },
        "source_cycle_id": {
          "type": "string",
          "pattern": "^cycle-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "source_cycle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_decision_id": {
          "type": "string",
          "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"
        },
        "observed_lifecycle": {
          "$ref": "#/$defs/lifecycle_state"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "exact_head_sha": {
          "$ref": "#/$defs/sha1"
        },
        "requested_owner_decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner_only_action"
          }
        },
        "supervisor_made_decision": {
          "const": false
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      }
    }
  }
}
