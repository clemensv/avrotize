      "id": "technical-evidence-and-tag-publication",
      "implementation": ".github/workflows/build_deploy.yml",
      "state": "current",
      "authority_owner": "repository-owner",
      "purpose": "Run conversion and VS Code evidence, then publish only for version tags.",
      "events": [
        "pull_request:master",
        "push:master",
        "push:tag:v*"
      ],
      "inputs": {
        "authoritative": [
          "repository content at checked-out revision",
          "test group matrix",
          "version tag"
        ],
        "advisory": [],
        "untrusted": [
          "pull request content"
        ]
      },
      "deterministic": {
        "outputs": [
          "pytest results",
          "VS Code test result",
          "tag publication result"
        ],
        "fail_closed": true
      },
      "copilot": {
        "enabled": false,
        "aic_source": "github-copilot-platform",
        "observed_run_aic": {
          "sample_size": 0,
          "p50": "TBD",
          "p95": "TBD"
        },
        "guardrails": {
          "per_run": "TBD",
          "daily": "TBD"
        },
        "token_telemetry": "operational-only"
      },
      "actions": {
        "runner_classes": [
          "ubuntu-latest"
        ],
        "typical_fan_out": 15,
        "maximum_fan_out": 16,
        "observed_runner_minutes_median": 60.82,
        "runner_minutes_ceiling": 480
      },
      "mutations": [
        "tag-only PyPI publication",
        "tag-only VS Code Marketplace publication"
      ],
      "permissions": [
        "contents:read"
      ],
      "result": {
        "exact_revision": "checked-out SHA",
        "blocking_scope": "technical evidence and tag publication",
        "retention": "GitHub Actions run and publication logs"
      }
