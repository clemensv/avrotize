    {
      "id": "guarded-bug-reproduction",
      "implementation": ".github/workflows/repro-bug.yml",
      "state": "current",
      "authority_owner": "repository-owner",
      "purpose": "Run a policy-bounded default-branch reproduction of an eligible bug report when a maintainer or admin requests it, then record structured evidence and exactly one governed state label.",
      "events": [
        "issues:[labeled=repro-requested]",
        "workflow_dispatch:issue_number"
      ],
      "jobs": [
        "authorize: decide permission before any checkout, install, or issue content read",
        "mark-in-progress: replace governed labels with repro-in-progress",
        "reproduce: execute the allowlisted command at the authorized trusted revision",
        "publish-final: always publish exactly one terminal governed label and a run comment"
      ],
      "inputs": {
        "authoritative": [
          "collaborator permission API response",
          "trusted default-branch revision",
          "checked-in reproduction command policy",
          "checked-in issue form contract",
          "checked-in label catalog",
          "commands.json"
        ],
        "advisory": [],
        "untrusted": [
          "issue body content",
          "reporter invocation text",
          "reporter minimal input fixture"
        ]
      },
      "deterministic": {
        "outputs": [
          "versioned authorization record",
          "versioned reproduction evidence record",
          "Markdown evidence summary"
        ],
        "fail_closed": true,
        "corruption_vs_incomplete": "Corrupt policy, schema, catalog, or authorization is an infrastructure failure and the workflow fails. Readiness, policy, timeout, and resource refusals produce BLOCKED evidence and exit 0.",
        "outcome_rules": [
          "readiness, policy, timeout, or resource refusal => BLOCKED",
          "expected success and nonzero exit => CONFIRMED",
          "expected success and zero exit without exact output => NEEDS_REVIEW",
          "declared exact output that matches the single output target => NOT_REPRODUCED",
          "declared exact output that differs from the single output target => CONFIRMED",
          "expected failure and nonzero exit => NOT_REPRODUCED",
          "expected failure and zero exit => CONFIRMED",
          "human semantic review, undeclared expectation, or ambiguous target => NEEDS_REVIEW"
        ]
      },
      "copilot": {
        "enabled": false,
        "aic_source": "github-copilot-platform",
        "observed_run_aic": {
          "sample_size": 0,
          "p50": "TBD",
          "p95": "TBD"
        },
        "guardrails": {
          "per_run": "TBD",
          "daily": "TBD"
        },
        "token_telemetry": "operational-only"
      },
      "actions": {
        "runner_classes": [
          "ubuntu-latest"
        ],
        "typical_fan_out": 4,
        "maximum_fan_out": 4,
        "runner_minutes_ceiling": 40
      },
      "mutations": [
        "governed reproduction state labels on the requested issue",
        "one issue comment linking the run, artifact, trusted revision, and authorized issue revision"
      ],
      "permissions": [
        "contents:read",
        "issues:read",
        "issues:write"
      ],
      "concurrency": "repro-bug-${issue_number}-${requesting_label_or_dispatch}",
      "artifact_retention_days": 14,
      "result": {
        "exact_revision": "trusted default-branch SHA resolved during authorization",
        "blocking_scope": "guarded reproduction evidence and state labels only",
        "retention": "14-day authorization and evidence artifacts, step summaries, and one issue comment"
      }
