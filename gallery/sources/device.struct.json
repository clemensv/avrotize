{
  "$schema": "https://json-structure.org/meta/extended/v0/#",
  "$id": "https://example.com/devices/device",
  "name": "Device",
  "type": "object",
  "properties": {
    "deviceId": { "type": "string" },
    "deviceType": { "type": "string" },
    "enabled": { "type": "boolean" },
    "installedAt": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "properties": {
        "building": { "type": "string" },
        "floor": { "type": "integer" }
      },
      "required": ["building", "floor"]
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        },
        "required": ["timestamp", "value", "unit"]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["deviceId", "deviceType", "enabled", "installedAt", "location", "readings", "tags"]
}
